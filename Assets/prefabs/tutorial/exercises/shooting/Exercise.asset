  exerciseName: "\u0422\u0438\u0440"
  description: "\u0412\u0430\u0448\u0430 \u0437\u0430\u0434\u0430\u0447\u0430 \u0440\u0430\u0441\u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C
    \u043A\u043E\u043B\u043E\u043D\u043D\u0443 \u0442\u0430\u043D\u043A\u0430 \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0431\u0443\u0434\u0435\u0442 \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0430\u0442\u044C\u0441\u044F
    \u0438\u0437 \u0442\u043E\u0447\u043A\u0438 \u0410 \u0432 \u0442\u043E\u0447\u043A\u0443
    \u0411, \u043F\u0440\u044F\u0447\u0430\u0441\u044C \u0437\u0430 \u0443\u043A\u0440\u044B\u0442\u044F\u043C\u0438.
    \u0434\u043B\u044F \u0442\u043E\u0433\u043E \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C
    \u0437\u0430\u0434\u0430\u043D\u0438\u0435 \u0434\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C
    \u043D\u0430 \u043E\u0433\u043D\u0435\u0432\u0443\u044E \u0442\u043E\u0447\u043A\u0443
    \u0441\u043F\u0440\u0430\u0432\u0430 \u0441\u043F\u0435\u0440\u0435\u0434\u0438,
    \u0432\u043E\u0437\u043B\u0435 \u0437\u043D\u0430\u043A\u0430"
