  m_Script: {fileID: 11500000, guid: e7ccf454782e2f8eaa63b00a7590d410, type: 3}
  m_Name: engine start sequense
  m_EditorClassIdentifier: Assembly-CSharp::TutorialData
  tutorialName: engine startup sequence
  description: 'u need to prepare engine for startup, for this u need to maintane
    fuel flow, air flow and ingition. so u need to press according buttons in this
    order: fuel -> air -> ignition'
  steps:
  - stepName: fuel button
    developerDescription: press fuel button
    pagePrefab: {fileID: 0}
    requiredEvent: 1
    eventParameter: FuelButton
    autoAdvance: 0
    autoAdvanceDelay: 0
    skippable: 0
  - stepName: air button
    developerDescription: press air button
    pagePrefab: {fileID: 0}
    requiredEvent: 1
    eventParameter: AirButton
    autoAdvance: 0
    autoAdvanceDelay: 0
    skippable: 0
  - stepName: ignition button
    developerDescription: press ignition button
    pagePrefab: {fileID: 0}
    requiredEvent: 1
    eventParameter: IgnitionButton
    autoAdvance: 0
    autoAdvanceDelay: 0
    skippable: 0
